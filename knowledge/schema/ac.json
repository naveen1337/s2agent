{
  "$id": "https://s2agent.local/schema/ac.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "AC product. Extends product.json. Extra specs map to schema:additionalProperty / specification.",
  "title": "AirConditioner",
  "description": "Air conditioner product — extends Base Product (product.json).",
  "allOf": [
    { "$ref": "./product.json" },
    {
      "type": "object",
      "required": ["product_type", "capacity_tonnage", "star_rating"],
      "properties": {
        "product_type": {
          "const": "ac",
          "description": "Discriminator. Export as schema:category / additionalType."
        },
        "capacity_tonnage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Cooling capacity in tons. e.g. 1.5."
        },
        "star_rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "BEE energy rating. Export as schema:hasEnergyConsumptionDetails."
        },
        "compressor_type": {
          "type": "string",
          "enum": ["inverter", "non-inverter", "dual-inverter"],
          "default": "inverter"
        },
        "refrigerant": {
          "type": "string",
          "examples": ["R32", "R410A"]
        },
        "condenser_coil": {
          "type": "string",
          "enum": ["copper", "aluminium"]
        },
        "air_swing_modes": {
          "type": "array",
          "items": { "type": "string" },
          "examples": [["4-way", "auto"]]
        },
        "filters": {
          "type": "array",
          "items": { "type": "string" },
          "examples": [["HD filter", "anti-virus"]]
        },
        "warranty_compressor_years": { "type": "integer", "minimum": 0 },
        "warranty_product_years": { "type": "integer", "minimum": 0 }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$examples": [
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "LG DUALCOOL AI AS-Q20JWZE",
      "alias_names": ["AS-Q20JWZE", "LG Dualcool 1.6T"],
      "model_code": "AS-Q20JWZE",
      "manufacturer": "LG",
      "parent_version": null,
      "current_version": "2025.1",
      "sector": ["home-appliances", "cooling"],
      "product_type": "ac",
      "capacity_tonnage": 1.6,
      "star_rating": 5,
      "compressor_type": "dual-inverter",
      "refrigerant": "R32"
    }
  ]
}
